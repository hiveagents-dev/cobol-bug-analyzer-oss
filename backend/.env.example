# LLM Provider Selection (vertex_ai or ollama)
LLM_PROVIDER=vertex_ai

# ============================================
# Vertex AI Configuration (when LLM_PROVIDER=vertex_ai)
# ============================================
GCP_PROJECT_ID=cobol-analyzer
GCP_LOCATION=europe-west1
VERTEX_MODEL=gemini-1.5-pro-002

# Optional: Path to service account credentials (for local development)
# In Cloud Run, uses default service account automatically
# GOOGLE_APPLICATION_CREDENTIALS=./config/gcp-credentials.json

# ============================================
# Ollama Configuration (when LLM_PROVIDER=ollama)
# ============================================
OLLAMA_ENDPOINT=http://host.docker.internal:11434
OLLAMA_MODEL=xmainframe:latest
OLLAMA_TIMEOUT=300

# ============================================
# API Configuration
# ============================================
API_KEY=your-api-key-here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
